<!-- Quy trình duyệt phiếu mượn của ví dụ "Sổ mượn sách": viết tay, chỉ dùng tập con BPMN mà lõi cho phép (P2-D2). -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="so-muon-sach-duyet-muon-definitions" targetNamespace="urn:dxos:so-muon-sach">
  <process id="so-muon-sach.duyet-muon" name="Duyệt phiếu mượn" isExecutable="true">
    <startEvent id="start" name="Bắt đầu"/>
    <sequenceFlow id="f_start" sourceRef="start" targetRef="duyet_muon"/>
    <userTask id="duyet_muon" name="Duyệt mượn" flowable:candidateGroups="app:so-muon-sach:thu_thu"/>
    <sequenceFlow id="f_duyet_muon" sourceRef="duyet_muon" targetRef="gw_duyet_muon"/>
    <exclusiveGateway id="gw_duyet_muon" name="Kết quả duyệt"/>
    <sequenceFlow id="f_duyet_muon_ok" sourceRef="gw_duyet_muon" targetRef="approved">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'approve'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_duyet_muon_no" sourceRef="gw_duyet_muon" targetRef="rejected">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'reject'}</conditionExpression>
    </sequenceFlow>
    <endEvent id="approved" name="Đã duyệt"/>
    <endEvent id="rejected" name="Từ chối"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="so-muon-sach.duyet-muon">
      <bpmndi:BPMNShape id="s_start" bpmnElement="start"><dc:Bounds x="20" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_duyet_muon" bpmnElement="duyet_muon"><dc:Bounds x="100" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gw_duyet_muon" bpmnElement="gw_duyet_muon" isMarkerVisible="true"><dc:Bounds x="245" y="95" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_approved" bpmnElement="approved"><dc:Bounds x="340" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_rejected" bpmnElement="rejected"><dc:Bounds x="340" y="222" width="36" height="36"/>
        <bpmndi:BPMNLabel id="l_rejected"><dc:Bounds x="330" y="262" width="56" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_start" bpmnElement="f_start"><di:waypoint x="56" y="120"/><di:waypoint x="100" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_duyet_muon" bpmnElement="f_duyet_muon"><di:waypoint x="200" y="120"/><di:waypoint x="245" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_duyet_muon_ok" bpmnElement="f_duyet_muon_ok"><di:waypoint x="295" y="120"/><di:waypoint x="340" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_duyet_muon_no" bpmnElement="f_duyet_muon_no"><di:waypoint x="270" y="145"/><di:waypoint x="270" y="240"/><di:waypoint x="340" y="240"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
