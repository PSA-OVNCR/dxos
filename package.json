{
  "name": "dxos-web",
  "version": "0.3.0",
  "private": true,
  "description": "Workspace npm của DX-OS Tầng 2: SDK trình duyệt, cổng xác minh, hai ứng dụng và ví dụ.",
  "license": "Apache-2.0",
  "packageManager": "npm@11.6.2",
  "engines": { "node": ">=22 <23", "npm": "11.6.2" },
  "workspaces": ["sdk/js", "verify-portal/app", "admin-ui", "apps/phong-ho-so/web", "apps/chung-nhan/web", "examples/so-muon-sach/web"],
  "scripts": {
    "check": "npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present && npm run build --workspaces --if-present",
    "typecheck:live": "tsc --noEmit -p tests/web/live",
    "test:live": "playwright test -c tests/web/live"
  },
  "overrides": {
    "@vue/compiler-core": "3.5.43",
    "@vue/compiler-dom": "3.5.43",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/compiler-ssr": "3.5.43",
    "@vue/reactivity": "3.5.43",
    "@vue/runtime-core": "3.5.43",
    "@vue/runtime-dom": "3.5.43",
    "@vue/server-renderer": "3.5.43",
    "@vue/shared": "3.5.43",
    "nopt": "9.0.0"
  }
}
