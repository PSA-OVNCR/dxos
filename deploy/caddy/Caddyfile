# Caddy: TLS + định tuyến tĩnh (spec 6.2). Caddy KHÔNG thấy trust-core-api:
# mọi lời gọi /api, /admin, /verify buộc đi qua APISIX.
# DXOS_DOMAIN=localhost thì Caddy tự dùng CA nội bộ (trình duyệt sẽ cảnh báo).

(gateway_routes) {
	@gateway path /api/* /admin/* /verify/* /view/*
	handle @gateway {
		reverse_proxy apisix:9080
	}
	# Cổng đối soát Vue (Plan 03 Task 6): bản build nằm trong volume apps-static ở /srv/apps/verify (Task 10 dựng vào).
	# handle_path cắt tiền tố nên /apps/verify/assets/x.js đọc /srv/apps/verify/assets/x.js. Caddy tự xếp handle theo
	# độ cụ thể của đường dẫn nên /apps/verify/* thắng /apps/* (kiểm bằng `caddy adapt` và curl).
	# DXOS_ANCHOR_RAW_ORIGIN: origin của repo neo công khai (ví dụ https://raw.githubusercontent.com) để trình duyệt tự
	# đối chiếu STH; để trống (mặc định) thì CSP chỉ cho connect-src 'self' và cổng được build không có repo neo.
	redir /apps/verify /apps/verify/ 308
	handle_path /apps/verify/* {
		root * /srv/apps/verify
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' {$DXOS_ANCHOR_RAW_ORIGIN}; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		file_server
	}
	# Trang đối soát tối giản (Plan 02 Task 10) giữ lại làm dự phòng: tĩnh, không build, CSP chặt. Gắn riêng ở
	# /srv/verify-lite (không lồng vào volume chỉ đọc apps-static ở /srv/apps).
	redir /apps/verify-lite /apps/verify-lite/ 308
	handle_path /apps/verify-lite/* {
		root * /srv/verify-lite
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		file_server
	}
	handle /apps/* {
		root * /srv
		file_server
	}
}

# Host công khai: người dùng, ứng dụng Tầng 2, cổng đối soát.
{$DXOS_DOMAIN} {
	# Console quản trị Keycloak chỉ mở trên host admin.
	@kc_admin path /auth/admin /auth/admin/*
	handle @kc_admin {
		respond "Not Found" 404
	}
	handle /auth/* {
		reverse_proxy keycloak:8080
	}
	# API quản trị chỉ mở trên host admin (spec 12.3). APISIX cũng ràng buộc route admin-v1 theo host; chặn ở đây
	# để host công khai không bao giờ chuyển /admin tới APISIX (phòng thủ nhiều lớp). Đường dẫn dài hơn /api/* nên
	# Caddy xếp handle này trước handle @gateway của gateway_routes.
	@admin_api path /admin/* /admin
	handle @admin_api {
		respond "Not Found" 404
	}
	import gateway_routes
	handle {
		respond "Not Found" 404
	}
}

# Host quản trị: chỉ IP cho phép (DXOS_ADMIN_ALLOWED_IPS, ví dụ "private_ranges" hoặc "203.0.113.7/32").
{$DXOS_ADMIN_HOST} {
	@blocked not remote_ip {$DXOS_ADMIN_ALLOWED_IPS}
	# Phải là `handle`: một `respond` rời rạc bị Caddy xếp SAU mọi `handle`, mà `handle {}` cuối khớp tất cả nên
	# danh sách IP không bao giờ được áp dụng. `handle @blocked` được xếp trước mọi handle còn lại (kiểm bằng
	# `caddy adapt` và tests/deploy/test_caddy_admin_allowlist_live.py).
	handle @blocked {
		respond "Forbidden" 403
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}
	import gateway_routes
	handle {
		respond "Not Found" 404
	}
}
