# Sao chép thành .env (ở thư mục gốc repo) rồi đổi mật khẩu. KHÔNG commit tệp .env.
# Giá trị dưới đây chạy được ngay trên máy cá nhân (localhost); khi lên VPS phải đổi hết.

# Tên miền công khai và host quản trị (localhost: Caddy tự cấp chứng chỉ nội bộ)
DXOS_DOMAIN=localhost
DXOS_ADMIN_HOST=admin.localhost
# IP được vào host quản trị: "private_ranges" cho máy cá nhân; trên VPS ghi IP cụ thể, ví dụ 203.0.113.7/32
DXOS_ADMIN_ALLOWED_IPS=private_ranges

# Mật khẩu dịch vụ (đổi khi triển khai thật)
KC_DB_PASSWORD=changeme-kc-db
KEYCLOAK_ADMIN_PASSWORD=changeme-kc-admin
FLOWABLE_DB_PASSWORD=changeme-flowable-db
FLOWABLE_REST_PASSWORD=changeme-flowable-rest
CORE_DB_OWNER_PASSWORD=changeme-core-owner
CORE_DB_APP_PASSWORD=changeme-core-app
S3_ACCESS_KEY=changeme-s3-access
S3_SECRET_KEY=changeme-s3-secret
# Client "apisix" trong realm dxos (Plan 01 Task 5 tạo client và đặt secret này)
APISIX_OIDC_CLIENT_SECRET=changeme-apisix-oidc

# Lõi Tầng 1 (Plan 01 Task 8)
DXOS_DATABASE_URL=postgresql://dxos_core:changeme-core-app@core-db:5432/dxos
