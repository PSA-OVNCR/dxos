# Sao chép thành .env (ở thư mục gốc repo) rồi đổi mật khẩu. KHÔNG commit tệp .env.
# Giá trị dưới đây chạy được ngay trên máy cá nhân (localhost); khi lên VPS phải đổi hết.

# Tên miền công khai và host quản trị (localhost: Caddy tự cấp chứng chỉ nội bộ)
DXOS_DOMAIN=localhost
DXOS_ADMIN_HOST=admin.localhost
# IP được vào host quản trị: "private_ranges" cho máy cá nhân; trên VPS ghi IP cụ thể, ví dụ 203.0.113.7/32
DXOS_ADMIN_ALLOWED_IPS=private_ranges

# Mật khẩu dịch vụ (đổi khi triển khai thật)
KC_DB_PASSWORD=changeme-kc-db
KEYCLOAK_ADMIN_PASSWORD=changeme-kc-admin
FLOWABLE_DB_PASSWORD=changeme-flowable-db
FLOWABLE_REST_PASSWORD=changeme-flowable-rest
CORE_DB_OWNER_PASSWORD=changeme-core-owner
CORE_DB_APP_PASSWORD=changeme-core-app
S3_ACCESS_KEY=changeme-s3-access
S3_SECRET_KEY=changeme-s3-secret
# Client "apisix" trong realm dxos (deploy/keycloak/realm-dxos.json đọc secret này khi nạp realm)
APISIX_OIDC_CLIENT_SECRET=changeme-apisix-oidc
# Client dxos-installer (service account cho installer, Plan 02)
DXOS_INSTALLER_CLIENT_SECRET=changeme-installer

# Lõi Tầng 1 (Plan 01 Task 8). DSN của trust-core do compose ghép từ CORE_DB_APP_PASSWORD.
# Khóa HMAC biến `sub` thành actor_ref trong ledger (đổi trên VPS: openssl rand -hex 32)
DXOS_ACTOR_HMAC_KEY=changeme-actor-hmac
# Múi giờ tính năm cho số văn bản đánh lại theo năm (spec 25.4); tên IANA
DXOS_TIMEZONE=Asia/Ho_Chi_Minh
# Token OpenBao cho trust-core (chỉ quyền sign/verify; Task 15 cấp token thật)
OPENBAO_CORE_TOKEN=changeme-openbao-core-token
# Neo STH lên GitHub (docs/runbook-anchor.md); để trống thì không neo. Dùng kèm deploy/compose.anchor.yaml
# DXOS_ANCHOR_REMOTE=git@github.com:<chủ-repo>/dxos-transparency-log.git

# Niêm phong và tuyên bố khóa seal-key (spec 25.3; Plan 02 Task 7). Tên tổ chức ghi VĨNH VIỄN vào tuyên bố khóa
# (bảng chỉ-thêm, đã neo) ở lần niêm phong đầu: đặt tên thật trước khi niêm phong trên VPS. Để trống thì lõi từ
# chối niêm phong (503 org-not-configured).
DXOS_ORG_NAME=changeme-ten-to-chuc
# Mã định danh tổ chức (ví dụ mã số doanh nghiệp); để trống = null
DXOS_ORG_ID=
# Thời hạn tuyên bố khóa, ngày (1..3650; tối đa 10 năm theo NĐ 23/2025 Điều 7 khoản 4)
DXOS_SEAL_KEY_VALIDITY_DAYS=3650
# Mục đích của khóa; để trống = câu mặc định của lõi
DXOS_SEAL_PURPOSE=
# URL chính sách khóa công khai; để trống = null
DXOS_KEY_POLICY_URL=
